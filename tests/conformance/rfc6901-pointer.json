{
  "format": "json-pointer",
  "standard": "RFC 6901 JSON Pointer",
  "version": "6901",
  "standard_url": "https://datatracker.ietf.org/doc/html/rfc6901",
  "provenance": "transcribed-from-rfc",
  "notes": "Section 5 of RFC 6901 gives one worked document and the twelve pointers that address every member of it, including the members whose names need escaping. The negative cases come from the syntax rules in section 3 and the evaluation rules in section 4, both of which say an implementation must report an error rather than guess.",
  "field_guide": {
    "document": "The JSON document the pointer is evaluated against.",
    "pointer": "The JSON Pointer under test, as a JSON string.",
    "expect": "resolve when the pointer must address a value, error when a conforming implementation must report an error.",
    "result": "Present only when expect is resolve: the value the pointer must address."
  },
  "cases": [
    {
      "id": "pointer-6901-whole-document",
      "title": "The empty pointer addresses the whole document",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"\" evaluates to the whole document.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "",
      "expect": "resolve",
      "result": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8}
    },
    {
      "id": "pointer-6901-object-member",
      "title": "/foo addresses an ordinary object member",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/foo\" evaluates to [\"bar\", \"baz\"].",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/foo",
      "expect": "resolve",
      "result": ["bar", "baz"]
    },
    {
      "id": "pointer-6901-array-index",
      "title": "/foo/0 addresses an array element",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/foo/0\" evaluates to \"bar\".",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/foo/0",
      "expect": "resolve",
      "result": "bar"
    },
    {
      "id": "pointer-6901-empty-name",
      "title": "/ addresses the member whose name is the empty string",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/\" evaluates to 0.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/",
      "expect": "resolve",
      "result": 0,
      "notes": "The empty string is a legal member name, so \"/\" is not the same pointer as \"\"."
    },
    {
      "id": "pointer-6901-escaped-slash",
      "title": "/a~1b addresses the member named a/b",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/a~1b\" evaluates to 1.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/a~1b",
      "expect": "resolve",
      "result": 1
    },
    {
      "id": "pointer-6901-percent",
      "title": "/c%d takes the percent sign literally",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/c%d\" evaluates to 2.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/c%d",
      "expect": "resolve",
      "result": 2,
      "notes": "Percent-decoding belongs to the URI fragment form in section 6, not to the JSON string form, so %d stays two characters here."
    },
    {
      "id": "pointer-6901-caret",
      "title": "/e^f takes the circumflex literally",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/e^f\" evaluates to 3.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/e^f",
      "expect": "resolve",
      "result": 3
    },
    {
      "id": "pointer-6901-pipe",
      "title": "/g|h takes the vertical bar literally",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/g|h\" evaluates to 4.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/g|h",
      "expect": "resolve",
      "result": 4
    },
    {
      "id": "pointer-6901-backslash",
      "title": "/i\\j addresses a member name containing a backslash",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/i\\\\j\" evaluates to 5.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/i\\j",
      "expect": "resolve",
      "result": 5,
      "notes": "The backslash is escaped by JSON string syntax, not by pointer syntax, so the pointer itself holds one backslash character."
    },
    {
      "id": "pointer-6901-quote",
      "title": "/k\"l addresses a member name containing a quotation mark",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/k\\\"l\" evaluates to 6.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/k\"l",
      "expect": "resolve",
      "result": 6
    },
    {
      "id": "pointer-6901-space",
      "title": "/ (slash space) addresses the member named with one space",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/ \" evaluates to 7.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/ ",
      "expect": "resolve",
      "result": 7,
      "notes": "Whitespace is not trimmed from a reference token."
    },
    {
      "id": "pointer-6901-escaped-tilde",
      "title": "/m~0n addresses the member named m~n",
      "section": "5",
      "section_title": "JSON String Representation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-5",
      "paragraph": "\"/m~0n\" evaluates to 8.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/m~0n",
      "expect": "resolve",
      "result": 8
    },
    {
      "id": "pointer-6901-missing-leading-slash",
      "title": "A non-empty pointer must begin with a solidus",
      "section": "3",
      "section_title": "Syntax",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-3",
      "paragraph": "A JSON Pointer is a Unicode string containing a sequence of zero or more reference tokens, each prefixed by a '/' character.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "foo",
      "expect": "error",
      "notes": "Accepting \"foo\" as a shorthand for \"/foo\" would make the empty member name unaddressable and is outside the grammar."
    },
    {
      "id": "pointer-6901-invalid-escape",
      "title": "~ may only be followed by 0 or 1",
      "section": "3",
      "section_title": "Syntax",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-3",
      "paragraph": "The ABNF for escaped is ( %x30 / %x31 ), so a tilde may only introduce ~0 or ~1.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/~2",
      "expect": "error"
    },
    {
      "id": "pointer-6901-trailing-tilde",
      "title": "A reference token may not end with a bare ~",
      "section": "3",
      "section_title": "Syntax",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-3",
      "paragraph": "An unescaped tilde is not in the unescaped character set, so a trailing tilde has no escape character to complete it.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/~",
      "expect": "error"
    },
    {
      "id": "pointer-6901-array-leading-zero",
      "title": "An array index may not carry a leading zero",
      "section": "4",
      "section_title": "Evaluation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-4",
      "paragraph": "The reference token must contain either characters comprised of digits with no leading zeros, or exactly the single character '-'.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/foo/01",
      "expect": "error",
      "notes": "A parser that reaches for a generic string-to-integer conversion reads 01 as 1 and silently returns \"baz\"."
    },
    {
      "id": "pointer-6901-array-out-of-range",
      "title": "An array index beyond the last element is an error",
      "section": "4",
      "section_title": "Evaluation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-4",
      "paragraph": "If the currently referenced value is a JSON array, the new referenced value is the array element with the zero-based index; an error condition is raised when the index is out of range.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/foo/2",
      "expect": "error"
    },
    {
      "id": "pointer-6901-missing-member",
      "title": "A member name that is not present is an error",
      "section": "4",
      "section_title": "Evaluation",
      "section_url": "https://datatracker.ietf.org/doc/html/rfc6901#section-4",
      "paragraph": "If the currently referenced value is a JSON object, the new referenced value is the object member with the name identified by the reference token; the member name is required to exist.",
      "requirement": "MUST",
      "document": {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8},
      "pointer": "/nosuch",
      "expect": "error"
    }
  ]
}
